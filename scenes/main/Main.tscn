[gd_scene format=3 godot_version="4.6.2"]

[ext_resource type="Script" path="res://scripts/main/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/board/board.gd" id="2_board"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="3_hud"]
[ext_resource type="Script" path="res://scripts/ui/action_menu.gd" id="4_menu"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; --- Tablero horizontal: HOME portería izquierda, AWAY portería derecha
; Dimensiones: 730px ancho (50+630+50) x 525px alto (5*105)
; Centrado verticalmente en ventana 1280x720 → top margin = (720-525)/2 = 97
[node name="Board" type="Node2D" parent="."]
position = Vector2(0, 97)
script = ExtResource("2_board")

; --- HUD: panel en la parte derecha, desde x=740 ---
[node name="HUDLayer" type="CanvasLayer" parent="."]

[node name="HUD" type="PanelContainer" parent="HUDLayer"]
offset_left = 745.0
offset_top = 10.0
offset_right = 1270.0
offset_bottom = 620.0
script = ExtResource("3_hud")

[node name="VBox" type="VBoxContainer" parent="HUDLayer/HUD"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ScoreLabel" type="Label" parent="HUDLayer/HUD/VBox"]
layout_mode = 2
text = "HOME  0  —  0  AWAY"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[node name="TurnLabel" type="Label" parent="HUDLayer/HUD/VBox"]
layout_mode = 2
text = "Turno: HOME"
theme_override_font_sizes/font_size = 16

[node name="ResultLabel" type="Label" parent="HUDLayer/HUD/VBox"]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

; --- Menú de acción: se superpone sobre el panel HUD (layer 5 > HUDLayer 1) ---
[node name="ActionMenuLayer" type="CanvasLayer" parent="."]
layer = 5

[node name="ActionMenu" type="PanelContainer" parent="ActionMenuLayer"]
visible = false
offset_left = 745.0
offset_top = 10.0
offset_right = 1270.0
offset_bottom = 620.0
script = ExtResource("4_menu")

[node name="VBox" type="VBoxContainer" parent="ActionMenuLayer/ActionMenu"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="ActionMenuLayer/ActionMenu/VBox"]
layout_mode = 2
text = "Elige acción"
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="ButtonsScroll" type="ScrollContainer" parent="ActionMenuLayer/ActionMenu/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ButtonsContainer" type="VBoxContainer" parent="ActionMenuLayer/ActionMenu/VBox/ButtonsScroll"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="CancelButton" type="Button" parent="ActionMenuLayer/ActionMenu/VBox"]
layout_mode = 2
text = "Cancelar"
